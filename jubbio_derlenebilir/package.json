{
  "name": "jubbio-client",
  "private": true,
  "version": "3.7.4",
  "type": "module",
  "main": "electron/main.cjs",
  "homepage": "https://jubbio.com",
  "author": {
    "name": "Jubbio",
    "email": "support@jubbio.com"
  },
  "description": "Jubbio Desktop App",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.jubbio.client.duzenlenmis",
    "npmRebuild": false,
    "productName": "Jubbio Duzenlenmis",
    "executableName": "Jubbio",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "files": [
      "electron/**/*",
      "!electron/tor/**",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/tor",
        "to": "tor"
      }
    ],
    "publish": null,
    "win": {
      "icon": "electron/resources/icons/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Jubbio-Duzenlenmis-Setup-${version}.exe"
    }
  },
  "overrides": {
    "tar": ">=7.5.21",
    "nanoid": ">=3.3.16",
    "brace-expansion": ">=5.0.5",
    "follow-redirects": ">=1.16.0",
    "postcss": ">=8.5.10",
    "axios": "$axios",
    "form-data": ">=4.0.6"
  }
}
